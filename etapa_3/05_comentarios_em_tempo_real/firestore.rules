rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /usuarios/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.nome is string
        && request.resource.data.email is string;
      allow delete: if false;
    }

    match /publicacoes/{publicacaoId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.autorId == request.auth.uid
        && request.resource.data.texto is string
        && request.resource.data.texto.size() > 0;
      allow delete: if request.auth != null
        && resource.data.autorId == request.auth.uid;
      allow update: if false;

      match /comentarios/{comentarioId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && exists(/databases/$(database)/documents/publicacoes/$(publicacaoId))
          && request.resource.data.autorId == request.auth.uid
          && request.resource.data.publicacaoId == publicacaoId
          && request.resource.data.texto is string
          && request.resource.data.texto.size() > 0;
        allow delete: if request.auth != null
          && resource.data.autorId == request.auth.uid;
        allow update: if false;
      }
    }
  }
}
