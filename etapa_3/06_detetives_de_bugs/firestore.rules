rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // referencias/bugs_original/ não continha firestore.rules.
    // Este arquivo é uma proposta para o seu projeto. Ele não foi publicado.
    match /ocorrencias/{ocorrenciaId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.autorId == request.auth.uid
        && request.resource.data.titulo is string
        && request.resource.data.local is string;
      allow update: if request.auth != null
        && resource.data.autorId == request.auth.uid
        && request.resource.data.autorId == resource.data.autorId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resolvido']);
      allow delete: if false;

      match /pistas/{pistaId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.resource.data.autorId == request.auth.uid
          && request.resource.data.mensagem is string
          && request.resource.data.mensagem.size() > 0;
        allow update, delete: if false;
      }
    }
  }
}
