rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Nada foi publicado no Firebase.
    // A atividade não tem login, então uma regra que deixe o aplicativo
    // gravar em `missoes` fica aberta para quem conhecer o projeto.
    // O arquivo permanece fechado. A decisão de publicar é sua, no console.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
